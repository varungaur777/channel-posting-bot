# Copy to .env and fill in.  NEVER commit .env (it is in .gitignore).
# On GitHub Actions the same names are set as repository Secrets / Variables instead.

# ---------------------------------------------------------------- required
# Token from @BotFather
BOT_TOKEN=
# Your own Telegram user id (owner = submitter + approver + all admin commands). /id shows it.
OWNER_ID=
# Users allowed to submit posts by DMing the bot (comma separated user ids). Owner is always allowed.
SUBMITTER_IDS=
# Users allowed to approve/reject (comma separated user ids). Owner is always allowed.
APPROVER_IDS=
# Private approval group (make it a SUPERGROUP first - the id changes on upgrade). Starts with -100.
APPROVAL_GROUP_ID=
# Private storage channel; only the bot is admin there. Every submission is copied here first.
STORAGE_CHANNEL_ID=
# Target channel where approved posts are published. Bot is admin with "Post Messages".
CHANNEL_ID=
# MongoDB Atlas connection string (MONGO_URI is accepted too). Empty = local JSON file (dev only).
MONGO_URL=
# Database name inside the cluster
MONGO_DB_NAME=channel_poster_bot

# ---------------------------------------------------------------- optional (defaults shown)
# Random gap between two channel posts, in minutes (never less than MIN). /setinterval overrides it.
MIN_INTERVAL_MIN=10
MAX_INTERVAL_MIN=15
# Time zone used when showing times (stored in UTC)
TZ_NAME=Asia/Kolkata
# Same content (same files + caption / text) is blocked for this many days
DUP_WINDOW_DAYS=30
# Owner gets a silent "bot restarted" message on every start
NOTIFY_RESTART=false
# Stop gracefully after N minutes (0 = run forever; github_actions profile defaults to 340)
MAX_RUNTIME_MINUTES=0
# persistent | github_actions | dev  (empty = auto-detect)
RUNTIME_PROFILE=
# DEBUG | INFO | WARNING  (empty = DEBUG in dev profile, else INFO)
LOG_LEVEL=
# Where the JSON fallback store lives / where rotating log files go
DATA_DIR=data
LOG_DIR=logs
# Write logs/bot.log as well as stdout (default: true except on GitHub Actions)
FILE_LOGGING=

# ---------------------------------------------------------------- tuning (rarely needed)
# How long to wait for the rest of an album before treating it as one post
ALBUM_WAIT_SECONDS=2.5
# Scheduler tick
TICK_SECONDS=20
# Remind the approval group when a post waits longer than this many minutes (0 = off)
PENDING_REMINDER_MIN=60
# Hour (0-23, TZ_NAME) when the owner gets the daily report (-1 = off)
DAILY_REPORT_HOUR=22
# Network-error retries before a post is marked failed (backoff 1, 2, 4, 8, 16... max 30 min)
MAX_RETRIES=5
# Instance lease (only one copy of the bot may poll Telegram)
LEASE_HEARTBEAT_SECONDS=30
LEASE_EXPIRY_SECONDS=120
